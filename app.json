{
  "expo": {
    "name": "rate-app",
    "slug": "rate-app",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/img/icon-official.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#00a680"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andrus.rate-app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00a680"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/img/icon-official.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ]
    ]
  }
}
